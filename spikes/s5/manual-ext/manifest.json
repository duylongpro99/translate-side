{
  "manifest_version": 3,
  "name": "S5 manual check (Alt+T, context menu)",
  "version": "0.0.1",
  "background": { "service_worker": "sw.js" },
  "action": {},
  "side_panel": { "default_path": "panel.html" },
  "permissions": ["sidePanel", "storage", "activeTab", "scripting", "contextMenus"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+T" } },
    "probe-command": { "suggested_key": { "default": "Alt+Shift+Y" }, "description": "Named command: probe activeTab" }
  }
}
