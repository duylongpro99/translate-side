{
  "manifest_version": 3,
  "name": "S10 Piper bench (spike)",
  "version": "0.0.1",
  "description": "Spike S10: Piper vi/en with our own G2P in an extension page. Not the product.",
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "background": {
    "service_worker": "background.js"
  }
}
