{
  "name": "translate-side",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Translate the current page in Chrome's side panel.",
  "license": "MIT",
  "packageManager": "pnpm@10.6.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:dev": "wxt build --mode development",
    "zip": "wxt zip",
    "store:screenshots": "node scripts/store-screenshots.mjs",
    "ui:screens": "node scripts/ui-screens.mjs",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/engine/tsconfig.json",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "pnpm run lint && pnpm run check:tokens && pnpm run typecheck && pnpm run check:engine && pnpm run test:coverage && pnpm run build && pnpm run check:bundle && pnpm run check:manifest",
    "check:engine": "node scripts/check-engine-boundary.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "engine:node": "node scripts/engine-node-run.mts",
    "eval": "node scripts/eval.mjs",
    "eval:capture": "node scripts/eval-capture.mjs",
    "eval:sheet": "node scripts/eval-sheet.mjs",
    "eval:detect": "node scripts/eval-detect.mjs",
    "eval:judge": "node scripts/eval-judge.mjs",
    "eval:report": "node scripts/eval-report.mjs",
    "eval:gate": "node scripts/eval-gate.mjs",
    "latency": "node scripts/latency.mjs",
    "faults": "node scripts/faults.mjs",
    "migration": "node scripts/migration.mjs",
    "e2e": "tsc --noEmit -p e2e/tsconfig.json && WXT_BEST_PREVIEW=1 wxt build && playwright test -c e2e/playwright.config.ts",
    "e2e:upgrade": "tsc --noEmit -p e2e/tsconfig.json && node scripts/e2e-upgrade.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24",
    "@vitest/coverage-v8": "5.0.3",
    "@wxt-dev/i18n": "0.2.8",
    "esbuild": "0.28.2",
    "eslint": "^10",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "preact": "^11.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7",
    "vitest": "5.0.3",
    "wxt": "0.21.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@mozilla/readability": "^0.6.0",
    "openai": "^7.28.0"
  }
}
